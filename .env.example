MONGO_URI=mongodb://127.0.0.1:27017/medcore?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
# Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_ACCESS_SECRET=

# Leave Stripe keys empty to use the local provider in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# KEKs are a JSON object mapping key IDs to base64-encoded 32-byte keys.
PRESCRIPTION_KEKS={}
PRESCRIPTION_ACTIVE_KEK_ID=kek-v1
# Ed25519 keys are base64 DER (PKCS8 private, SPKI public).
AUDIT_ANCHOR_PRIVATE_KEY=
AUDIT_ANCHOR_PUBLIC_KEY=
# Optional path to independently protected storage. Defaults to .audit-anchors.
# AUDIT_ANCHOR_DIR=
API_RATE_LIMIT=1000
LOGIN_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MS=60000
